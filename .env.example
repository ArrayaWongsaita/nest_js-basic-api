NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/app
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m
AUTH_REFRESH_COOKIE_NAME=refresh_token
AUTH_REFRESH_TTL=30d
CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password

# Swagger docs
SWAGGER_ENABLED=false
SWAGGER_USERNAME=swagger
SWAGGER_PASSWORD=change-me

# Data-reset and demo-seed endpoints are rejected in production unless this is true
ADMIN_MAINTENANCE_ALLOW_IN_PRODUCTION=false

# Demo user seed
# Run: npm run bootstrap:demo-users
# Seeds student1@mail.com through student60@mail.com
# Shared password: 1234567891011
