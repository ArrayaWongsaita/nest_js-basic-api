generator client {
  provider               = "prisma-client"
  output                 = "../generated/prisma"
  engineType             = "client"
  runtime                = "nodejs"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = ""
}

datasource db {
  provider = "postgresql"
}

// ====================
// IAM
// ====================

model User {
  id                    String                 @id @default(uuid())
  email                 String                 @unique
  passwordHash          String
  isActive              Boolean                @default(true)
  isSystem              Boolean                @default(false)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  roles                 UserRole[]
  authSession           AuthSession?
  todos                 Todo[]
  notes                 Note[]
  contacts              Contact[]
  books                 Book[]
  movies                Movie[]
  financialTransactions FinancialTransaction[]
  habits                Habit[]
  products              Product[]
  blogPosts             BlogPost[]
  jobApplications       JobApplication[]
  events                Event[]
  recipes               Recipe[]
  courses               Course[]
  travelPlans           TravelPlan[]
  wishlistItems         WishlistItem[]
  orders                Order[]
  quizzes               Quiz[]
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  isSystem    Boolean          @default(false)
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id    String           @id @default(uuid())
  name  String           @unique
  isSystem Boolean       @default(false)
  roles RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model AuthSession {
  id               String   @id @default(uuid())
  userId           String   @unique
  refreshTokenHash String   @unique
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

// ====================
// Todo
// ====================

model Todo {
  id          String    @id @default(uuid())
  userId      String
  title       String
  description String?
  isCompleted Boolean   @default(false)
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ====================
// Note
// ====================

model Note {
  id        String   @id @default(uuid())
  userId    String
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ====================
// Contact Manager
// ====================

model Contact {
  id        String   @id @default(uuid())
  userId    String
  firstName String
  lastName  String?
  email     String?
  phone     String?
  company   String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ====================
// Book Library
// ====================

model Book {
  id            String     @id @default(uuid())
  userId        String
  title         String
  author        String
  genre         String?
  publishedYear Int?
  status        BookStatus @default(TO_READ)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ====================
// Movie Watchlist
// ====================

model Movie {
  id          String      @id @default(uuid())
  userId      String
  title       String
  director    String?
  genre       String?
  releaseYear Int?
  status      MovieStatus @default(TO_WATCH)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ====================
// Expense Tracker
// ====================

model FinancialTransaction {
  id              String          @id @default(uuid())
  userId          String
  title           String
  amount          Decimal         @db.Decimal(12, 2)
  type            TransactionType
  note            String?
  transactionDate DateTime
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ====================
// Habit Tracker
// ====================

model Habit {
  id          String     @id @default(uuid())
  userId      String
  name        String
  description String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs        HabitLog[]

  @@index([userId])
}

model HabitLog {
  id          String   @id @default(uuid())
  habitId     String
  completedOn DateTime
  note        String?
  createdAt   DateTime @default(now())
  habit       Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, completedOn])
  @@index([habitId])
}

// ====================
// Product Inventory
// ====================

model Product {
  id          String   @id @default(uuid())
  userId      String
  name        String
  sku         String?
  description String?
  quantity    Int      @default(0)
  price       Decimal? @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ====================
// Simple Blog
// ====================

model BlogPost {
  id          String         @id @default(uuid())
  userId      String
  title       String
  slug        String         @unique
  content     String
  status      BlogPostStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ====================
// Job Application Tracker
// ====================

model JobApplication {
  id            String               @id @default(uuid())
  userId        String
  companyName   String
  positionTitle String
  status        JobApplicationStatus @default(SAVED)
  appliedAt     DateTime?
  jobUrl        String?
  note          String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ====================
// Event
// ====================

model Event {
  id          String    @id @default(uuid())
  userId      String
  title       String
  description String?
  location    String?
  startAt     DateTime
  endAt       DateTime?
  isAllDay    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ====================
// Recipe
// ====================

model Recipe {
  id           String   @id @default(uuid())
  userId       String
  name         String
  description  String?
  ingredients  String
  instructions String
  prepMinutes  Int?
  cookMinutes  Int?
  servings     Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ====================
// Course
// ====================

model Course {
  id             String   @id @default(uuid())
  userId         String
  title          String
  instructorName String?
  provider       String?
  level          String?
  courseUrl      String?
  durationHours  Int?
  isCompleted    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ====================
// Travel Plan
// ====================

model TravelPlan {
  id          String    @id @default(uuid())
  userId      String
  destination String
  startDate   DateTime
  endDate     DateTime?
  budget      Decimal?  @db.Decimal(12, 2)
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ====================
// Wishlist
// ====================

model WishlistItem {
  id          String   @id @default(uuid())
  userId      String
  name        String
  description String?
  storeName   String?
  productUrl  String?
  targetPrice Decimal? @db.Decimal(12, 2)
  isPurchased Boolean  @default(false)
  priority    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ====================
// Order Tracker
// ====================

model Order {
  id        String      @id @default(uuid())
  userId    String
  status    OrderStatus @default(PENDING)
  orderedAt DateTime
  note      String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     OrderItem[]

  @@index([userId])
  @@index([userId, orderedAt])
  @@index([userId, status])
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  name      String
  quantity  Int
  unitPrice Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ====================
// Quiz Builder
// ====================

model Quiz {
  id          String         @id @default(uuid())
  userId      String
  title       String
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions   QuizQuestion[]

  @@index([userId])
}

model QuizQuestion {
  id             String       @id @default(uuid())
  quizId         String
  questionText   String
  questionType   QuestionType @default(SHORT_TEXT)
  expectedAnswer String
  position       Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  quiz           Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([quizId, position])
  @@index([quizId])
}

enum BookStatus {
  TO_READ
  READING
  COMPLETED
}

enum MovieStatus {
  TO_WATCH
  WATCHING
  WATCHED
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
}

enum JobApplicationStatus {
  SAVED
  APPLIED
  INTERVIEWING
  OFFERED
  REJECTED
  WITHDRAWN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum QuestionType {
  SHORT_TEXT
  TRUE_FALSE
}
